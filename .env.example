# Скопируйте этот файл в .env и заполните значениями

# Секретный ключ Flask (для сессий). Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# API ключ Яндекс Карт (получить на https://developer.tech.yandex.ru/)
YANDEX_MAPS_API_KEY=your-yandex-api-key-here

# Ключ HTTP-геокодера Яндекса — для адреса точки на экране результата
# («Это было: Невский проспект, 28»). Это ОТДЕЛЬНЫЙ сервис в кабинете
# разработчика Яндекса. Если не задан — используется ключ карт; если и он
# не подходит/не задан — игра работает без адресов.
# YANDEX_GEOCODER_API_KEY=your-geocoder-api-key-here

# Безопасность cookie сессии.
# true (по умолчанию) — cookie только по HTTPS (прод).
# Для локальной разработки по http:// выставьте false, иначе сессия не сохранится.
SESSION_COOKIE_SECURE=true

# Включить отладочный режим Flask (только для локальной разработки!). По умолчанию false.
FLASK_DEBUG=false

# URI базы данных (необязательно). По умолчанию — SQLite-файл в папке instance/.
# Примеры: sqlite:////abs/path/app.db  или  postgresql://user:pass@host/db
# DATABASE_URL=sqlite:///geoguessr_spb.db

# Автоматически применять миграции БД при старте (по умолчанию true).
# Выключите, если накатываете миграции отдельным шагом деплоя: flask db upgrade
# AUTO_MIGRATE=true

# Rate limiting API (по умолчанию true). Отключать имеет смысл только в тестах.
# RATELIMIT_ENABLED=true

# Ключ модератора пула точек — открывает страницу /admin с картой всех
# проверенных панорам (удаление точек внутри зданий и т.п.). Сгенерировать:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
# Не задан — админка полностью выключена.
# ADMIN_KEY=

# Номер счётчика Яндекс Метрики (создать на https://metrika.yandex.ru).
# Не задан — аналитика выключена. Цели, которые шлёт клиент: game_start,
# game_complete, daily_start, challenge_accept, challenge_share.
# METRIKA_ID=12345678
